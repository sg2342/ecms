{application, ecms,
 [{description, "RFC5652 Cryptographic Message Syntax (CMS)"},
  {vsn, "1.1.0"},
  {registered, []},
  {applications,
   [kernel,
    stdlib,
    public_key,
    asn1,
    crypto,
    rfc3394
   ]},
  {env,[]},
  {modules, [ecms, 'CMS', 'PKIX1Explicit88', 'PKIX1-PSS-OAEP-Algorithms']},

  {include_paths, ["asn1"]},
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/sg2342/ecms"}]}
 ]}.
